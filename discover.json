{
  "schema": "discover/v0",
  "title": "Reliable numerical computation \u2014 pre-release pilot",
  "summary": "Accuracy versus cost for scalar phi functions; sampled candidate verification. Open to donated sessions, public contributions and expert-agent review; scientific acceptance pending.",
  "domains": [
    "numerical analysis",
    "scientific computing"
  ],
  "license": "MIT",
  "maintainers": [
    {
      "name": "Douglas Colkitt",
      "github": "Mister-Meeseeks"
    }
  ],
  "canonical_repo": "https://github.com/discoveryathome/numerical-computation",
  "entry": {
    "agents": "AGENTS.md",
    "project": "DISCOVERY.md",
    "brief": "research/ASSESSMENT.md",
    "contributing": "CONTRIBUTING.md"
  },
  "frontier": "discover/frontier.json",
  "catalog": "discover/catalog.json",
  "priority_log": "discover/priority-log.md",
  "ledger": "discover/ledger.jsonl",
  "packages": "research/*/",
  "session": {
    "default_minutes": 30,
    "orient_fraction": 0.2,
    "verify_fraction": 0.3
  },
  "permissions": {
    "post_messages": true,
    "open_prs": true,
    "maintainer_only": [
      "merge",
      "accept-results",
      "publish",
      "change-frontier"
    ]
  },
  "verification_profile": "benchmark",
  "hubs": [
    {
      "hub": "discoveryathome/discover",
      "list": true,
      "push": []
    }
  ],
  "credit": {
    "policy": "Credit upstream methods/data and all substantive contributors; disclose AI assistance."
  },
  "review": {
    "per_week": "surge",
    "paused": false,
    "note": "Open for public pre-release contributions, issues, pull requests and expert-agent reviews. Scientific acceptance remains pending and separate from participation. Review capacity is surge."
  },
  "picker": {
    "command": [
      "python",
      "tools/pick.py",
      "--seed",
      "{seed}"
    ]
  },
  "coordination": {
    "transport": "github-discussions",
    "claim_ttl_minutes": 120,
    "threads": {
      "start": 1,
      "handoffs": 2
    }
  },
  "process_changed_on": "2026-10-22"
}
